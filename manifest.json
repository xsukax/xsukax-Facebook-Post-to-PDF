{
  "manifest_version": 3,
  "name": "xsukax Facebook Post PDF",
  "version": "1.4.0",
  "description": "Save editable Facebook posts as a styled PDF, with author avatar support and manual corrections.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Save Facebook post to PDF",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.fbcdn.net/*"
  ]
}
